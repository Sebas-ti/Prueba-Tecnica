  "components": {
    "schemas": {
      "Body_upload_documents_v1_documents_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files",
            "description": "Uno o más archivos .pdf, .docx, .md, .txt"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_upload_documents_v1_documents_post"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 2,
            "title": "Question",
            "examples": [
              "¿Cuál es el SLA de resolución de una solicitud P2?"
            ]
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{6,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Permite conversación multi-turno. Si se omite se crea una nueva sesión."
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "interaction_id": {
            "type": "string",
            "title": "Interaction Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "answered | no_info | blocked | output_blocked | incomplete"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/ToolCallTrace"
            },
            "type": "array",
            "title": "Tool Calls"
          },
          "grounding": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Grounding"
              },
              {
                "type": "null"
              }
            ]
          },
          "security": {
            "additionalProperties": true,
            "type": "object",
            "title": "Security"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Usage"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "interaction_id",
          "session_id",
          "answer",
          "status",
          "sources",
          "tool_calls",
          "grounding",
          "security",
          "usage",
          "model",
          "prompt_version",
          "latency_ms"
        ],
        "title": "ChatResponse"
      },
      "DocumentInfo": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "chunks": {
            "type": "integer",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "source",
          "chunks"
        ],
        "title": "DocumentInfo"
      },
      "Grounding": {
        "properties": {
          "score": {
            "type": "number",
            "title": "Score"
          },
          "grounded": {
            "type": "boolean",
            "title": "Grounded"
          },
          "evaluated_sentences": {
            "type": "integer",
            "title": "Evaluated Sentences"
          },
          "unsupported_sentences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unsupported Sentences"
          },
          "invalid_citations": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Invalid Citations"
          }
        },
        "type": "object",
        "required": [
          "score",
          "grounded",
          "evaluated_sentences",
          "unsupported_sentences",
          "invalid_citations"
        ],
        "title": "Grounding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryPage": {
        "properties": {
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "items",
          "count"
        ],
        "title": "HistoryPage"
      },
      "IngestionResponse": {
        "properties": {
          "ingested": {
            "items": {
              "$ref": "#/components/schemas/IngestionResult"
            },
            "type": "array",
            "title": "Ingested"
          },
          "errors": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Errors",
            "default": []
          },
          "total_chunks_in_index": {
            "type": "integer",
            "title": "Total Chunks In Index"
          }
        },
        "type": "object",
        "required": [
          "ingested",
          "total_chunks_in_index"
        ],
        "title": "IngestionResponse"
      },
      "IngestionResult": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "chunks": {
            "type": "integer",
            "title": "Chunks"
          },
          "replaced_chunks": {
            "type": "integer",
            "title": "Replaced Chunks"
          },
          "flagged_chunks": {
            "type": "integer",
            "title": "Flagged Chunks"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          }
        },
        "type": "object",
        "required": [
          "source",
          "chunks",
          "replaced_chunks",
          "flagged_chunks",
          "embedding_model",
          "elapsed_ms"
        ],
        "title": "IngestionResult"
      },
      "Source": {
        "properties": {
          "ref": {
            "type": "integer",
            "title": "Ref"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "cited": {
            "type": "boolean",
            "title": "Cited"
          }
        },
        "type": "object",
        "required": [
          "ref",
          "source",
          "section",
          "score",
          "snippet",
          "cited"
        ],
        "title": "Source"
      },
      "ToolCallTrace": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          }
        },
        "type": "object",
        "required": [
          "name",
          "arguments",
          "ok",
          "elapsed_ms"
        ],
        "title": "ToolCallTrace"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}