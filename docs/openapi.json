{
  "openapi": "3.1.0",
  "info": {
    "title": "IC7 Enterprise RAG Agent",
    "description": "\nAgente RAG empresarial para el sistema de **gestión de solicitudes internas**.\n\n* **/v1/chat** — preguntas en lenguaje natural; el agente busca en la documentación\n  (RAG híbrido) y usa herramientas (estado, prioridad, esfuerzo, resumen, servicios cloud).\n* **/v1/documents** — carga y procesamiento de documentos (PDF, DOCX, MD, TXT).\n* **/v1/history** — trazabilidad completa de interacciones.\n\nAutenticación: cabecera `X-API-Key` (deshabilitada solo en `ENVIRONMENT=local`).\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operación"
        ],
        "summary": "Liveness",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "operación"
        ],
        "summary": "Readiness",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "tags": [
          "asistente"
        ],
        "summary": "Consultar al asistente",
        "description": "Envía una pregunta al agente. Devuelve respuesta, fuentes citadas, herramientas usadas,\nevaluación de fundamentación y banderas de seguridad.",
        "operationId": "chat_v1_chat_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents": {
      "post": {
        "tags": [
          "documentos"
        ],
        "summary": "Cargar y procesar documentos",
        "description": "Ingesta: extracción de texto -> chunking -> embeddings -> vector store.\nRe-cargar un archivo con el mismo nombre reemplaza su versión anterior.",
        "operationId": "upload_documents_v1_documents_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_documents_v1_documents_post"
