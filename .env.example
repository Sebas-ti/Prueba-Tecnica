# ============================================================================
# Configuración del Agente RAG. Copie a .env y complete. NUNCA versione .env.
# ============================================================================

# --- Aplicación ---
# local | dev | test | prod  (dev/prod exigen API_KEYS)
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Proveedores ---
# Modo 100 % local (sin credenciales): local / local / sqlite
# Modo Azure: azure / azure_search / cosmos
LLM_PROVIDER=local
VECTOR_STORE_PROVIDER=local
HISTORY_PROVIDER=sqlite

# --- Azure OpenAI ---
# Si AZURE_OPENAI_API_KEY queda vacío se usa Entra ID (az login / identidad administrada).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
# minimal | low | medium | high (solo modelos de razonamiento)
REASONING_EFFORT=medium
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=ic7-knowledge

# --- Azure Cosmos DB ---
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=ragagent
COSMOS_CONTAINER=interactions

# --- Observabilidad ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- RAG ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
# Local (coseno+BM25): 0.30 | Azure AI Search con reranker semántico (0-4 normalizado): 0.40
MIN_RELEVANCE_SCORE=0.30

# --- Agente ---
AGENT_MAX_ITERATIONS=5
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800

# --- Seguridad ---
# lista separada por comas; vacío solo permitido en local
API_KEYS=
MAX_QUESTION_CHARS=2000
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.md,.txt
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=
